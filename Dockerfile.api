# API image for registry publishing (Unraid template / ghcr.io).
#
# Build context is the REPO ROOT (unlike the compose build, whose context is
# ./backend). The frontend is baked into the image so no bind-mount is
# needed: app.py resolves FRONTEND_DIR to /app/frontend by default.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/data

WORKDIR /app

# curl is handy for container healthchecks/debugging;
# ffmpeg stitches print timelapses from camera frames.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend
COPY frontend/ ./frontend

EXPOSE 8080

CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8080"]
