# Print Bridge environment settings.
# Copy to .env and edit:  cp .env.example .env

# Printer — Moonraker on the Snapmaker U1 (PAXX firmware).
PRINTER_URL=http://192.168.68.242:7125

# Filament inventory — Spoolman, the source of truth for what's loaded where.
SPOOLMAN_URL=http://192.168.68.84:7912

# Bridge pipeline alerts. Subscribe to this topic in the ntfy app on your
# phone to get print alerts. Empty = disabled.
NTFY_TOPIC=u1-print-bridge
NTFY_SERVER=https://ntfy.sh

# MakerWorld downloads (optional). Best-effort only — MakerWorld is behind
# Cloudflare and may refuse server-side downloads.
# How to get the value: open MakerWorld in your browser (logged in) ->
# DevTools -> Application -> Cookies -> copy the session cookie value.
# If downloads fail, the app will ask you to upload the 3MF file manually.
MAKERWORLD_SESSION_COOKIE=

# Where the services keep job state and slice files. Must match the
# printbridge-data volume mount (/data) in docker-compose.yml.
DATA_DIR=/data

# Public URL of the bridge UI, used in notification links. Empty is fine
# for LAN-only use.
BRIDGE_URL=
