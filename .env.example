# Print Bridge environment settings.
# Copy to .env and edit:  cp .env.example .env

# Printer — Moonraker on the Snapmaker U1 (PAXX firmware).
PRINTER_URL=http://192.168.68.242:7125

# Filament inventory — Spoolman, the source of truth for what's loaded where.
SPOOLMAN_URL=http://192.168.68.84:7912

# Bridge pipeline alerts. Subscribe to this topic in the ntfy app on your
# phone to get print alerts. Empty = disabled.
NTFY_TOPIC=u1-print-bridge
NTFY_SERVER=https://ntfy.sh

# MakerWorld downloads (optional). MakerWorld only lets logged-in users
# download models, so the bridge needs your session cookie to fetch a 3MF
# directly. How to get the value: in your browser (logged in to MakerWorld)
# open DevTools -> Network -> reload a MakerWorld model page -> click any
# makerworld.com request -> Request Headers -> copy the whole `Cookie:`
# header value and paste it here. It expires after a while (days to weeks);
# when downloads start failing with a login message, re-paste a fresh one.
# If downloads fail, the app will ask you to upload the 3MF file manually.
MAKERWORLD_SESSION_COOKIE=

# Bambu -> U1 converter sidecar (optional). The bridge calls this service
# over HTTP to rewrite Bambu/MakerWorld 3MF project files into U1 project
# files before slicing. Empty = conversion disabled, original file used as-is.
# Unraid: http://192.168.68.84:8084 (u1-print-bridge-converter container).
# Compose: http://converter:8080 (set in docker-compose.yml).
CONVERTER_URL=

# Where the services keep job state and slice files. Must match the
# printbridge-data volume mount (/data) in docker-compose.yml.
DATA_DIR=/data

# Public URL of the bridge UI, used in notification links. Empty is fine
# for LAN-only use.
BRIDGE_URL=
